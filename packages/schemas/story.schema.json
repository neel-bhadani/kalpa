{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kalpa.studio/schemas/story.schema.json",
  "title": "Story",
  "description": "Spec of a \"story\" asset: what the story is about, its acts, characters and themes. Owned by the Story & Script module. Ids are stable UUIDs made by the client.",
  "x-schema-version": 2,
  "type": "object",
  "required": ["title"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "logline": { "type": "string", "maxLength": 500 },
    "genre": { "type": "string", "maxLength": 100 },
    "tone": { "type": "string", "maxLength": 100 },
    "audience": { "type": "string", "maxLength": 100 },
    "language": { "$ref": "#/$defs/language" },
    "target_length": { "description": "Minutes.", "type": "number", "minimum": 0, "maximum": 600 },
    "synopsis": { "type": "string", "maxLength": 20000 },
    "acts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "maxLength": 200 },
          "summary": { "type": "string", "maxLength": 5000 }
        }
      }
    },
    "characters": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "role": { "type": "string", "maxLength": 100 },
          "description": { "type": "string", "maxLength": 5000 },
          "character_asset_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
        }
      }
    },
    "themes": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    }
  },
  "$defs": {
    "id": { "type": "string", "format": "uuid" },
    "language": { "description": "BCP 47 tag, e.g. en, hi, gu.", "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "maxLength": 35 }
  }
}
