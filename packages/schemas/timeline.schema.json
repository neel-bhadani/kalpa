{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kalpa.studio/schemas/timeline.schema.json",
  "title": "Timeline",
  "description": "Spec of a \"timeline\" asset. Minimal for now; the owning module extends it.",
  "x-schema-version": 1,
  "type": "object",
  "required": [
    "fps",
    "tracks"
  ],
  "properties": {
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 240
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    }
  }
}
