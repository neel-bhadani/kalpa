{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kalpa.studio/schemas/video.schema.json",
  "title": "Video",
  "description": "Spec of a \"video\" asset. Minimal for now; the owning module extends it.",
  "x-schema-version": 1,
  "type": "object",
  "required": [
    "mime"
  ],
  "properties": {
    "mime": {
      "type": "string",
      "pattern": "^video/"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "file_name": {
      "type": "string"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "width": {
      "type": "integer"
    },
    "height": {
      "type": "integer"
    }
  }
}
