{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kalpa.studio/schemas/script.schema.json",
  "title": "Script",
  "description": "Spec of a \"script\" asset: scenes of typed lines (screenplay elements). Owned by the Story & Script module. Scene and line ids are stable UUIDs made by the client; script_scenes and script_lines mirror them.",
  "x-schema-version": 2,
  "type": "object",
  "required": ["title", "scenes"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "format": { "enum": ["screenplay", "short", "ad", "story"] },
    "story_asset_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "language": { "description": "BCP 47 tag, e.g. en, hi, gu.", "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "maxLength": 35 },
    "target_duration_s": { "type": "integer", "minimum": 0, "maximum": 36000 },
    "scenes": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "heading", "lines"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "heading": { "description": "e.g. INT. NIGHT MARKET - NIGHT", "type": "string", "maxLength": 200 },
          "location": { "type": "string", "maxLength": 200 },
          "time_of_day": { "type": "string", "maxLength": 50 },
          "summary": { "type": "string", "maxLength": 2000 },
          "lines": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "required": ["id", "type", "text"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "type": { "enum": ["action", "character", "dialogue", "parenthetical", "transition", "narration"] },
                "character_id": { "description": "A character of the linked story, for character, dialogue and parenthetical lines.", "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
                "text": { "type": "string", "maxLength": 5000 },
                "emotion": { "type": "string", "maxLength": 50 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "format": "uuid" }
  }
}
