{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kalpa.studio/schemas/scene.schema.json",
  "title": "Scene",
  "description": "Spec of a \"scene\" asset. Minimal for now; the owning module extends it.",
  "x-schema-version": 1,
  "type": "object",
  "required": [
    "name",
    "fps"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 240
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "camera": {
      "type": "object"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
