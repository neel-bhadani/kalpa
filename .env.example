# Docker Compose settings. Copy to .env (never commit .env).

# Host port for the Caddy gateway: http://localhost:8089
KALPA_HTTP_PORT=8089

# Your host user, so files written by containers stay editable (run `id -u` / `id -g`).
UID=1000
GID=1000

# Must match DB_* in apps/api/.env
POSTGRES_DB=kalpa
POSTGRES_USER=kalpa
POSTGRES_PASSWORD=kalpa

# S3 identity for kalpa-seaweedfs. Must match AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in apps/api/.env
S3_ACCESS_KEY=kalpa
S3_SECRET_KEY=kalpa-secret

# Reverb (websockets). Shared by api, horizon, scheduler, reverb and web through compose.yaml.
# Use your own random values (e.g. `openssl rand -hex 24`).
REVERB_APP_ID=kalpa
REVERB_APP_KEY=change-me-key
REVERB_APP_SECRET=change-me-secret
