# Docker Compose settings. Copy to .env (never commit .env).

# Host port for the Caddy gateway: http://localhost:8089
KALPA_HTTP_PORT=8089

# Your host user, so files written by containers stay editable (run `id -u` / `id -g`).
UID=1000
GID=1000

# Must match DB_* in apps/api/.env
POSTGRES_DB=kalpa
POSTGRES_USER=kalpa
POSTGRES_PASSWORD=kalpa
