APP_NAME="Kalpa Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8089

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kalpa
DB_USERNAME=kalpa
DB_PASSWORD=kalpa

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# 127.0.0.1:8089 is a second browser origin on this machine (its own storage), handy as a second device.
SANCTUM_STATEFUL_DOMAINS=localhost:8089,127.0.0.1:8089

# Reverb settings come from compose.yaml (x-laravel-env), fed by the root .env.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# kalpa-seaweedfs (S3). Keys must match S3_ACCESS_KEY / S3_SECRET_KEY in the root .env.
AWS_ACCESS_KEY_ID=kalpa
AWS_SECRET_ACCESS_KEY=kalpa-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=kalpa
AWS_ENDPOINT=http://seaweedfs:8333
AWS_PUBLIC_ENDPOINT=http://localhost:8089
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
